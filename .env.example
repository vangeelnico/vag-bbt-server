# Kopieer dit bestand naar C:\vag-bbt\.env en vul in.
# .env komt NOOIT op GitHub (staat in .gitignore).

# BBT API-key (BBT > Instellingen > Algemeen > Bedrijf > API-key)
BBT_API_KEY=

# Je vaste ngrok-adres (ngrok dashboard > Domains), met https://
PUBLIC_URL=https://jouwnaam.ngrok-free.app

# Wachtwoord om Claude toegang te geven (minstens 12 tekens, nergens anders gebruiken)
ADMIN_PASSWORD=

# Mappen op de Windows-pc (hoeft normaal niet te veranderen)
BBT_EXPORT_DIR=C:\vag-bbt\export
DATA_DIR=C:\vag-bbt\data
PORT=8787
